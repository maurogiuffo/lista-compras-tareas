# Copiar a .env y ajustar. docker compose lo lee automáticamente.
WEB_PORT=8080
# 127.0.0.1 si la app va detrás de un nginx/proxy en el mismo server (recomendado).
WEB_BIND=0.0.0.0
LOG_LEVEL=info
# Ruta donde se publica la app: "/" o, por ejemplo, "/lista/" (con barras). Requiere --build.
BASE_PATH=/
# "off" o un texto para pedir usuario y contraseña (archivo auth/htpasswd, ver DEPLOY.md).
AUTH_BASIC=off
# Usuario si no hay login; también recibe los ítems previos a que hubiera usuarios.
DEFAULT_USER=local
